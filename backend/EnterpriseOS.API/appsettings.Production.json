{
  "ConnectionStrings": {
    "DefaultConnection": "#{DB_CONNECTION}#"
  },
  "AppSettings": {
    "JwtSecret":    "#{JWT_SECRET}#",
    "JwtIssuer":    "EnterpriseOS",
    "JwtAudience":  "EnterpriseOS-Client",
    "AIAgentUrl":   "#{AI_AGENT_URL}#"
  },
  "Logging": {
    "LogLevel": {
      "Default":                "Warning",
      "Microsoft.AspNetCore":   "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
